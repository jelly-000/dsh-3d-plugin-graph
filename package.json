{
  "name": "dsh-3d-plugin-graph",
  "version": "0.1.1",
  "description": "DSH 3D Plugin Graph: black-white 3D plugin space visualization with 360° rotation, free node drag, hover/click popups, and runtime flow effects.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "docs",
    "compatibility.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "test:ui": "node scripts/ui-test.mjs",
    "test:security": "node scripts/security-test.mjs",
    "test:perf": "node scripts/perf-test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "dshClient": {
    "inject": [],
    "platform": "web"
  },
  "license": "MIT"
}
